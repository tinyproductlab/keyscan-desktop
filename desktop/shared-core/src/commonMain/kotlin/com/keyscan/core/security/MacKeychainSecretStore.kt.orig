package com.keyscan.core.security

import java.nio.CharBuffer
import java.nio.charset.StandardCharsets
import java.nio.file.Files
import java.nio.file.Path
import java.util.Locale

/** Stores application secrets in the current user's macOS login Keychain. */
class MacKeychainSecretStore(
    private val service: String = DEFAULT_SERVICE,
    private val securityTool: Path = Path.of("/usr/bin/security"),
) : SecretStore {
    init {
        require(isMacOs()) { "macOS Keychain is only available on macOS" }
        require(service.matches(SERVICE_ID)) { "Invalid Keychain service identifier" }
        require(Files.isExecutable(securityTool)) { "macOS security tool is unavailable" }
    }

    override fun put(id: String, secret: CharArray) {
        validateId(id)
        val encoded = StandardCharsets.UTF_8.encode(CharBuffer.wrap(secret))
        val bytes = ByteArray(encoded.remaining()).also(encoded::get)
        val hexChars = CharArray(bytes.size * 2)
        bytes.forEachIndexed { index, byte ->
            val value = byte.toInt() and 0xff
            hexChars[index * 2] = HEX[value ushr 4]
            hexChars[index * 2 + 1] = HEX[value and 0x0f]
        }
        val process = ProcessBuilder(
            securityTool.toString(), "add-generic-password", "-U",
            "-a", id, "-s", service, "-X", String(hexChars),
        ).start()
        process.outputStream.close()
        val output = process.inputStream.readAllBytes()
        val error = process.errorStream.readAllBytes()
        try {
            if (process.waitFor() != 0) throw VaultAuthenticationException(
                "Keychain credential could not be saved${errorText(error)}"
            )
        } finally {
            output.fill(0)
            error.fill(0)
            bytes.fill(0)
            hexChars.fill('\u0000')
        }
    }

    override fun get(id: String): CharArray? {
        validateId(id)
        val process = ProcessBuilder(
            securityTool.toString(), "find-generic-password",
            "-a", id, "-s", service, "-w",
        ).start()
        process.outputStream.close()
        val output = process.inputStream.readAllBytes()
        val error = process.errorStream.readAllBytes()
        return try {
            val exit = process.waitFor()
            if (exit == ITEM_NOT_FOUND) null
            else if (exit != 0) throw VaultAuthenticationException(
                "Keychain credential could not be read${errorText(error)}"
            ) else String(output, StandardCharsets.UTF_8).trimEnd('\r', '\n').toCharArray()
        } finally {
            output.fill(0)
            error.fill(0)
        }
    }

    override fun remove(id: String) {
        validateId(id)
        val process = ProcessBuilder(
            securityTool.toString(), "delete-generic-password", "-a", id, "-s", service,
        ).redirectErrorStream(true).start()
        process.outputStream.close()
        val output = process.inputStream.readAllBytes()
        try {
            val exit = process.waitFor()
            if (exit != 0 && exit != ITEM_NOT_FOUND) throw VaultAuthenticationException("Keychain credential could not be removed")
        } finally { output.fill(0) }
    }

    private fun validateId(id: String) = require(ID.matches(id)) { "Invalid secret identifier" }
    private fun errorText(bytes: ByteArray): String = String(bytes, StandardCharsets.UTF_8).trim().take(160).let { if (it.isEmpty()) "" else ": $it" }

    companion object {
        private const val DEFAULT_SERVICE = "com.keyscan.desktop.secrets"
        private const val ITEM_NOT_FOUND = 44
        private val ID = Regex("[A-Za-z0-9_-]{1,64}")
        private val SERVICE_ID = Regex("[A-Za-z0-9._-]{1,128}")
        private val HEX = "0123456789abcdef".toCharArray()
        fun isMacOs(): Boolean = System.getProperty("os.name", "").lowercase(Locale.ROOT).startsWith("mac")
    }
}
