{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "0.1.64",
  "description": "__MSG_appDescription__",
  "permissions": ["activeTab", "storage", "alarms",
    "nativeMessaging"],
  "background": { "scripts": ["background.js"] },
  "action": { "default_popup": "popup.html", "default_title": "KeyScan" },
  "content_scripts": [{ "matches": ["https://*/*", "http://*/*"], "js": ["content.js"], "run_at": "document_idle" }],
  "browser_specific_settings": {
    "gecko": {
      "id": "keyscan@keyscan.app",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["authenticationInfo", "websiteActivity"] }
    },
    "gecko_android": { "strict_min_version": "142.0" }
  },
  "default_locale": "en"
}
